# Base URL of the API, as the BROWSER sees it. Default is the relative "/api/v1":
#  - dev: Vite proxies /api to the Express API (see vite.config.ts)
#  - production: your reverse proxy / API gateway serves /api on the same origin as the web app
# Only set this if the API lives on a different origin (then it also needs CORS + cookie changes).
# VITE_API_BASE_URL=/api/v1
