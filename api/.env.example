# Copy to .env and fill in. .env is git-ignored; this example file is committed so a new
# developer (or a deployment) can see every variable the API needs. Real values never go here.
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=kishanpermand
DB_PASSWORD=

# Auth. JWT_SECRET signs login cookies: 32+ random characters, different per environment.
# Generate one with:  openssl rand -hex 48
JWT_SECRET=
# How long a login lasts, in seconds (86400 = 1 day). Also used as the cookie lifetime.
JWT_EXPIRES_IN_SECONDS=86400

# The ONE browser origin allowed to call this API with cookies (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
